# .env.example
# Environment Configuration Template
# 
# Copy this file to .env and fill in your actual values
# The .env file is in .gitignore and should NEVER be committed to version control
#
# For production deployments, use environment variables or secret management services
# See docs/SECURE_CREDENTIALS_MANAGEMENT.md for detailed setup instructions

# ============================================================================
# EMAIL NOTIFICATION CONFIGURATION
# ============================================================================

# Enable/disable email notifications globally
EMAIL_ENABLED=true

# Email account that sends the alerts
# For Gmail: use your Gmail address
# IMPORTANT: This must match the account associated with EMAIL_APP_PASSWORD
EMAIL_SENDER=your-email@gmail.com

# App Password for email authentication
# SECURITY: This is NOT your regular email password
# For Gmail:
#   1. Enable 2-Factor Authentication in Google Account
#   2. Go to Google Account → Security → App Passwords
#   3. Generate an App Password for "Mail" on "Windows Computer" (or your device)
#   4. Copy the 16-character password here
# WARNING: Never commit this file with real credentials to version control
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Friendly name displayed in email clients (e.g., from field)
# Helps recipients identify the automated service
# The "(No-Reply)" suffix discourages direct replies
EMAIL_SENDER_DISPLAY_NAME=Stock Alerter (No-Reply)

# Email addresses that receive public notifications
# Comma-separated list (e.g., "user1@example.com,user2@example.com")
# These addresses appear in the "To" field of the email
EMAIL_RECEIVERS=recipient1@example.com,recipient2@example.com

# Email addresses that receive private notifications
# Comma-separated list (e.g., "admin@example.com")
# These addresses are in the BCC field (not visible to other recipients)
EMAIL_BCC_RECEIVERS=admin@example.com

# ============================================================================
# NTFY PUSH NOTIFICATION CONFIGURATION
# ============================================================================

# Enable/disable ntfy push notifications
NTFY_ENABLED=false

# ntfy topic names (comma-separated)
# Topics are public - anyone who knows the topic name can subscribe
# Use random, hard-to-guess strings for privacy
# Example: "stock_alerts_a1b2c3d4,backup_alerts_x9y8z7w6"
NTFY_TOPICS=vn30_alerts_f8a9b2c1

# ============================================================================
# TWILIO SMS NOTIFICATION CONFIGURATION
# ============================================================================

# Enable/disable SMS notifications via Twilio
TWILIO_ENABLED=false

# Twilio Account SID
# Get this from: https://www.twilio.com/console
# Looks like: "ACxxxxxxxxxxxxxxxxxx"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx

# Twilio Authentication Token
# Get this from: https://www.twilio.com/console
# WARNING: Keep this secret - it allows anyone to use your Twilio account
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number (from which SMS will be sent)
# Format: "+1234567890" (include country code)
TWILIO_PHONE_NUMBER=+1234567890

# Phone number that receives SMS alerts
# Format: "+1234567890" (include country code)
SMS_RECEIVER_PHONE_NUMBER=+84983794189

# ============================================================================
# CLOUD PLATFORM CONFIGURATION (Optional)
# ============================================================================
# Set ONE of these when deploying to cloud platforms
# The application automatically detects the platform and loads credentials accordingly

# Azure Key Vault Configuration
# Set this URL if deploying to Azure Container Instances or similar
# Example: "https://your-vault.vault.azure.net/"
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# Google Cloud Configuration
# Set this if deploying to Google Cloud Run or similar
# Example: "my-gcp-project-id"
# GOOGLE_CLOUD_PROJECT=my-gcp-project-id

# Docker Configuration
# Set to "true" if running in a Docker container
# DOCKER_CONTAINER=false

# ============================================================================
# KUBERNETES CONFIGURATION (Optional)
# ============================================================================
# Set this if running in Kubernetes cluster
# Kubernetes automatically injects this variable
# KUBERNETES_SERVICE_HOST=kubernetes.default

# ============================================================================
# NOTES FOR DEVELOPERS
# ============================================================================
# 
# 1. LOCAL DEVELOPMENT:
#    - Copy this file: cp .env.example .env
#    - Fill in your credentials in .env
#    - Never commit .env to Git
#    - The .env file is loaded from environment variables by SecretsLoader
#
# 2. PRODUCTION DEPLOYMENT:
#    - Do NOT use .env file in production
#    - Use environment variables injected by Docker/Kubernetes
#    - Use cloud secret management services:
#      * Azure Key Vault (set AZURE_KEYVAULT_URL)
#      * Google Secret Manager (set GOOGLE_CLOUD_PROJECT)
#      * AWS Secrets Manager (coming soon)
#
# 3. CREDENTIAL ROTATION:
#    - Update credentials in your secret management service
#    - No code changes needed - application loads them automatically
#    - Restart application to pick up new credentials
#
# 4. DEBUGGING:
#    - Check logs to see which configuration source is being used
#    - Verify credentials are correct before deploying
#    - Use configuration validation: python -c "from src.stockreports.config.notification_settings import *; print('OK')"
#
# For more information, see:
# - docs/SECURE_CREDENTIALS_MANAGEMENT.md (implementation details)
# - docs/EMAIL_CONFIGURATION_ANALYSIS.md (credential usage analysis)
